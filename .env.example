# Base de datos
DATABASE_URL="postgresql://user:password@localhost:5432/diario_salud?schema=public"

# Redis (BullMQ)
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# Auth
JWT_SECRET="change-me"
JWT_EXPIRES_IN="8h"

# API publica de solo lectura (GET /articles) -- header X-API-Key
PUBLIC_API_KEY="change-me-too"

# Proveedor de IA (Gemini; ver LlmModule para intercambiar proveedor)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.1-flash-lite"

# Tope diario de articulos EVALUADO que pasan a rewrite/grounding/compliance
# (ver RewriteSelectionService) -- freno principal contra otro agotamiento
# de credito como el del 2026-07-12.
DAILY_REWRITE_LIMIT="5"

# Piso de calidad (0-1, relevanceScore de Scoring): un articulo solo pasa a
# rewrite/grounding/compliance si supera esto, ademas de estar en el top
# DAILY_REWRITE_LIMIT. Si nada lo supera un dia dado, no se selecciona nada.
MIN_RELEVANCE_SCORE_FOR_REWRITE="0.5"

# Presupuesto maximo REAL en USD para llamadas a la API de Gemini (ver
# LlmBudgetService) -- medido con los tokens reales reportados por la API,
# no una estimacion. Omitir = sin limite.
MAX_LLM_BUDGET_USD="5"

# Mismo mecanismo, techo independiente para el chatbot publico de inventario
# (stages con prefijo chat_) -- evita que el trafico del chatbot agote el
# presupuesto del pipeline editorial o viceversa. Omitir = sin limite.
MAX_LLM_BUDGET_CHATBOT_USD="5"

# Integracion Distrimonaco (inventario) -- ver DistrimonacoSyncService.
# Sin URL/key definidos, la sincronizacion se omite (no rompe el arranque).
DISTRIMONACO_API_URL="https://apiweb.distrimonaco.com:9097/Api/EcoFarma/ProductosStock"
DISTRIMONACO_API_KEY=""
DISTRIMONACO_SYNC_INTERVAL_MINUTES="60"
DISTRIMONACO_BRANCH_CODE="PRINCIPAL"

# Espejo de articulos PUBLICADO hacia el WordPress de EcoFarma (ver
# WordpressPublishService) -- WORDPRESS_APP_PASSWORD es una Application
# Password de WordPress (Usuarios > Perfil > Contrasenas de aplicacion),
# nunca la contrasena real de la cuenta. Sin credenciales definidas, el
# espejo se omite (no rompe el arranque).
WORDPRESS_BASE_URL="https://ecofarma.co"
WORDPRESS_USERNAME=""
WORDPRESS_APP_PASSWORD=""
WORDPRESS_CATEGORY_ID="2861"
WORDPRESS_SYNC_INTERVAL_MINUTES="15"
# Cloudflare (delante de ecofarma.co) bloquea con 403 el trafico de
# wp-json/wp/v2/* que llega desde la IP de salida de Render -- este valor
# debe coincidir con el que se configure en la regla de firewall de
# Cloudflare (header X-EcoFarma-Backend-Secret) para que el espejo funcione.
WORDPRESS_BACKEND_SECRET=""

# App
PORT="3000"
# development | test | staging | production
NODE_ENV="development"
