# Base de datos
DATABASE_URL="postgresql://user:password@localhost:5432/diario_salud?schema=public"

# Redis (BullMQ)
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# Auth
JWT_SECRET="change-me"
JWT_EXPIRES_IN="8h"

# API publica de solo lectura (GET /articles) -- header X-API-Key
PUBLIC_API_KEY="change-me-too"

# Proveedor de IA (Claude por defecto; ver LlmModule para intercambiar proveedor)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# WordPress (Application Password nativo de WP, no un plugin)
WORDPRESS_BASE_URL="https://ecofarma.co"
WORDPRESS_APP_USERNAME=""
WORDPRESS_APP_PASSWORD=""
WORDPRESS_DIARIO_SALUD_CATEGORY_ID=""

# App
PORT="3000"
NODE_ENV="development"
