// EcoFarma - Diario de la Salud
// Ver /Users/daymer/.claude/plans/precious-hopping-duckling.md para el diseno completo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EDITOR
  VALIDATOR
  VIEWER
}

enum SourceType {
  RSS
  HTML_SCRAPE
  OPEN_DATA_API
}

enum FetchMethod {
  HTTP_SIMPLE
  HEADLESS_BROWSER
}

enum RiskLevel {
  BAJO
  MEDIO
  ALTO
}

/// Brief seccion 12: dimension de taxonomia independiente del riesgo --
/// clasifica la NATURALEZA del contenido, no su nivel de riesgo (un
/// articulo puede ser type-alerta y riesgo-bajo a la vez).
enum ContentType {
  ALERTA
  PREVENCION
  VIGILANCIA
}

enum CheckStatus {
  PENDIENTE
  APROBADO
  RECHAZADO
}

// El orden de los valores importa para el CHECK "draft_requires_clean_checks" en la migracion:
// todo estado desde BORRADOR en adelante exige grounding y compliance APROBADO.
enum ArticleState {
  RECOLECTADO
  DESCARTADO
  EVALUADO
  REESCRITO
  GROUNDING_FALLIDO
  CUMPLIMIENTO_FALLIDO
  BORRADOR
  EN_VALIDACION
  VALIDADO
  RECHAZADO
  PUBLICADO
  ERROR
}

enum ValidationDecision {
  VALIDADO
  RECHAZADO
  EDITADO_Y_VALIDADO
}

enum ActorType {
  SYSTEM
  AI
  HUMAN
}

enum IngestionRunStatus {
  PROGRAMADO
  EN_CURSO
  COMPLETADO
  CANCELADO
}

enum IngestionTriggerType {
  MANUAL
  SCHEDULED
}

enum IngestionRunSourceStatus {
  PENDIENTE
  EN_CURSO
  COMPLETADO
  ERROR
}

/// Historial de corridas de ingesta -- una fila por disparo del
/// dispatcher, ya sea manual (boton "Consultar ahora" / "Correr ahora" o
/// una corrida programada a futuro desde el calendario -- ambas cuentan
/// como MANUAL porque hay un humano detras) o automatico (Source.scheduledTime,
/// triggerType SCHEDULED). Registra QUE se disparo y CUANDO, no el detalle
/// de cada articulo (eso sigue viviendo en Article/AuditLog).
/// createdByUserId es null en corridas SCHEDULED -- no hay un humano detras de esas.
/// Una corrida programada a futuro se crea con status PROGRAMADO y
/// startedAt = la fecha/hora elegida; al dispararse el cron solo cambia el
/// status (startedAt ya coincide con la hora real de disparo). "Termina"
/// (finishedAt) significa fin de la etapa de ingesta unicamente -- las
/// etapas de IA que siguen (score/rewrite/grounding/compliance) corren
/// despues de forma independiente y no bloquean finishedAt.
model IngestionRun {
  id          String               @id @default(uuid())
  status      IngestionRunStatus   @default(PROGRAMADO)
  triggerType IngestionTriggerType
  /// institutionCode[] de las fuentes incluidas en esta corrida.
  sourceCodes Json
  startedAt   DateTime?
  finishedAt  DateTime?

  createdByUserId String?
  createdBy       User?   @relation("IngestionRunCreatedBy", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())

  /// Progreso por fuente dentro de esta corrida (2026-07-17, pedido
  /// explicito del usuario: "muestra que fuente se esta consultando en
  /// ese momento, paso a paso") -- ver comentario de IngestionRunSource.
  sources IngestionRunSource[]

  @@index([status, startedAt])
  /// Ademas de este indice, la migracion 20260717190000 agrega un indice
  /// UNIQUE parcial (WHERE status = 'EN_CURSO') que Prisma no puede
  /// expresar en este DSL -- garantiza a nivel de base de datos que nunca
  /// exista mas de una corrida EN_CURSO a la vez. Ver IngestionRunsService
  /// .startNow()/markRunning() para donde se atrapa la violacion.
  @@map("ingestion_runs")
}

/// Progreso de UNA fuente dentro de UNA corrida -- lo que alimenta el
/// "paso a paso" del panel (pedido explicito del usuario 2026-07-17: ver
/// que fuente se esta consultando en este momento, no solo el resumen
/// final de la corrida). Las filas se crean todas en PENDIENTE apenas
/// arranca la corrida (mismo orden que sourceCodes) y las va actualizando
/// IngestionRunTrackerService al vuelo, escuchando los eventos
/// 'active'/'completed'/'failed' de BullMQ -- nunca se infiere el estado
/// desde otro lado (nunca se inventa que una fuente "ya debe haber
/// terminado" solo por tiempo transcurrido).
///
/// jobId es determinista por fuente+minuto (ver IngestionDispatcher
/// .enqueueSource) y un mismo job puede pertenecer a mas de una corrida
/// (dos disparos en el mismo minuto) -- por eso esta fila es por
/// (runId, sourceId), no por jobId: cada corrida lleva su propio progreso
/// aunque comparta el trabajo real de fondo con otra.
model IngestionRunSource {
  id              String                   @id @default(uuid())
  runId           String
  run             IngestionRun             @relation(fields: [runId], references: [id], onDelete: Cascade)
  sourceId        String
  source          Source                   @relation(fields: [sourceId], references: [id])
  institutionCode String
  status          IngestionRunSourceStatus @default(PENDIENTE)
  startedAt       DateTime?
  finishedAt      DateTime?
  itemsCreated    Int?
  itemsDuplicate  Int?
  errorMessage    String?

  createdAt DateTime @default(now())

  @@unique([runId, sourceId])
  @@map("ingestion_run_sources")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(VIEWER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdSources         Source[]       @relation("SourceCreatedBy")
  updatedSources         Source[]       @relation("SourceUpdatedBy")
  validatedArticles      Article[]      @relation("ArticleValidator")
  publishedArticles      Article[]      @relation("ArticlePublishedBy")
  scheduledIngestionRuns IngestionRun[] @relation("IngestionRunCreatedBy")

  @@map("users")
}

/// Catalogo cerrado de fuentes oficiales autorizadas (brief secciones 4 y 4.1-4.2).
/// Solo un ADMIN puede crear/editar filas aqui - la IA y el resto del pipeline
/// solo leen via SourceRegistryService. Ningun Article puede existir sin un
/// sourceId valido que apunte a una fila de esta tabla (whitelist estructural).
model Source {
  id                   String      @id @default(uuid())
  institutionCode      String      @unique
  name                 String
  type                 SourceType
  baseUrl              String
  country              String
  /// Config especifica del adapter: feed URL, selectores de scraping, endpoint de API, etc.
  config               Json
  fetchMethod          FetchMethod @default(HTTP_SIMPLE)
  isActive             Boolean     @default(true)
  /// Hora del dia (formato "HH:mm", 24h) a la que se dispara la ingesta
  /// automatica de esta fuente, una vez por dia. null = solo manual (via
  /// el boton "Consultar ahora" del panel) -- este es el valor por
  /// defecto tras el incidente de agotamiento de credito del
  /// 2026-07-12 (ver RssAdapter): ninguna fuente ingiere sola salvo que
  /// alguien lo configure explicitamente.
  scheduledTime        String?
  /// Proxima ejecucion programada -- solo tiene sentido cuando
  /// scheduledTime no es null; se recalcula en SourcesService cada vez
  /// que scheduledTime cambia, y IngestionDispatcher la avanza +24h tras
  /// disparar.
  nextRunAt            DateTime?
  lastSuccessfulCursor Json?
  consecutiveFailures  Int         @default(0)
  /// Tope de items nuevos por corrida de ingesta, configurable desde el
  /// panel (pestaña Fuentes) -- un solo campo uniforme para los tres
  /// tipos de adapter (antes vivia disperso dentro de `config` con
  /// nombres distintos por tipo: maxItemsPerFeed en RSS, maxItemsPerRun
  /// en HTML_SCRAPE, limit en OPEN_DATA_API). null = usa el default
  /// propio de cada adapter. Ver comentario del incidente de agotamiento
  /// de credito del 2026-07-12 en rss.adapter.ts -- este es el freno de
  /// primera linea contra que otra corrida traiga miles de items de golpe.
  maxItemsPerRun       Int?
  /// Ventana de recencia en dias, configurable desde el panel -- se
  /// aplica en RSS y HTML_SCRAPE (filtra por fecha ANTES de aplicar
  /// maxItemsPerRun, igual que ya hacia RssAdapter). null = usa el
  /// default propio del adapter. No aplica a OPEN_DATA_API (SIVIGILA se
  /// ordena por semana/anio, no tiene una fecha de item individual util
  /// para este filtro).
  maxAgeDays           Int?

  createdByUserId String?
  createdBy       User?   @relation("SourceCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUserId String?
  updatedBy       User?   @relation("SourceUpdatedBy", fields: [updatedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles         Article[]
  ingestionRunRows IngestionRunSource[]

  @@map("sources")
}

/// Tabla central de procesamiento (brief seccion 9). Los campos de procedencia
/// son NOT NULL desde la creacion de la fila: ningun articulo existe sin fuente
/// oficial trazable. Ver migracion 0001 para los CHECK constraints que hacen
/// las invariantes de publicacion/cumplimiento inviolables a nivel de base de datos.
model Article {
  id String @id @default(uuid())

  // --- Procedencia (obligatoria, inmutable, nunca inventada) ---
  sourceId              String
  source                Source   @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  externalId            String?
  sourceUrl             String
  sourceInstitution     String
  sourcePublishedAt     DateTime
  fetchedAt             DateTime @default(now())
  originalTitle         String
  originalExcerpt       String?
  originalContent       String
  originalContentHash   String
  originalSnapshotUrl   String?
  imageUrl              String?
  /// Cuantas veces ArticleImageBackfillService intento recuperar la
  /// imagen despues de la ingesta inicial (2026-07-17, pedido explicito
  /// del usuario: un job periodico y deterministico -- SIN IA -- que
  /// reintenta la misma cadena de extraccion og:image/selector cuando
  /// imageUrl quedo null). Tope MAX_BACKFILL_ATTEMPTS ahi mismo: sin este
  /// contador, un articulo que genuinamente no tiene imagen (ej.
  /// Minciencias, verificado en vivo que ni el feed ni og:image traen
  /// nada) se reintentaria cada corrida del cron para siempre.
  imageBackfillAttempts Int      @default(0)
  language              String   @default("es")

  // --- Filtrado / puntuacion (IA) ---
  isRelevant      Boolean?
  relevanceScore  Float?
  relevanceReason String?
  riskLevel       RiskLevel?
  riskReason      String?
  contentType     ContentType?

  // --- Reescritura (IA) ---
  rewrittenTitle        String?
  rewrittenSummary      String?
  rewrittenContent      String?
  // Brief seccion 11: secciones obligatorias del articulo publicado que
  // no encajan en titulo/resumen/cuerpo -- "Puntos clave" (lista breve) y
  // "Por que es importante" (bloque contextual). Ver PublishService.buildPostBody.
  rewrittenKeyPoints    String[] @default([])
  rewrittenWhyItMatters String?
  rewriteModel          String?
  rewriteAttempts       Int      @default(0)

  // --- Verificacion de fidelidad (anti-invencion) ---
  groundingStatus CheckStatus?
  groundingReport Json?

  // --- Cumplimiento normativo ---
  complianceStatus CheckStatus?
  complianceReport Json?

  // --- Estado / maquina de estados ---
  state            ArticleState @default(RECOLECTADO)
  errorStage       String?
  lastErrorMessage String?

  // --- Validacion humana (obligatoria antes de publicar) ---
  validatorId        String?
  validator          User?               @relation("ArticleValidator", fields: [validatorId], references: [id])
  validationDecision ValidationDecision?
  validationNotes    String?
  validatedAt        DateTime?

  // --- Publicacion (solo tras validacion, directo a nuestra API publica -- sin WordPress) ---
  publishedAt       DateTime?
  publishedByUserId String?
  publishedBy       User?     @relation("ArticlePublishedBy", fields: [publishedByUserId], references: [id])

  // --- Deduplicacion ---
  isDuplicateOf String?
  duplicateOf   Article?  @relation("ArticleDuplicates", fields: [isDuplicateOf], references: [id])
  duplicates    Article[] @relation("ArticleDuplicates")

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceId, originalContentHash])
  @@index([state])
  @@index([sourcePublishedAt])
  @@map("articles")
}

/// Bitacora de auditoria de solo-anexo (append-only). El rol de base de datos
/// que usa la aplicacion no debe tener privilegios UPDATE/DELETE sobre esta
/// tabla (configurar a nivel de rol de Postgres, fuera de Prisma).
model AuditLog {
  id         String    @id @default(uuid())
  entityType String
  entityId   String
  action     String
  actorType  ActorType
  actorId    String?
  fromState  String?
  toState    String?
  payload    Json?
  createdAt  DateTime  @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}

/// Registro de cada llamada real a la API de Anthropic, con el costo
/// calculado a partir de los tokens que la API realmente reporto en
/// `usage` (nunca estimado antes de la llamada). Es la fuente de verdad
/// que LlmBudgetService consulta para decidir si bloquear la siguiente
/// llamada -- ver su comentario para el porque de este freno (presupuesto
/// maximo en USD, MAX_LLM_BUDGET_USD).
model LlmCall {
  id           String   @id @default(uuid())
  stage        String
  model        String
  inputTokens  Int
  outputTokens Int
  costUsd      Decimal  @db.Decimal(10, 6)
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@map("llm_calls")
}

/// Una fila por cada instruccion que se le envia a Claude como
/// `system` prompt (ver PromptKey). Piso 2026-07-16: el usuario pidio
/// que los prompts NO vivan hardcodeados en el codigo -- deben poder
/// editarse (o redefinir sus reglas) desde el panel sin un deploy.
/// El seed crea la version por defecto de cada key si no existe una fila
/// todavia; una vez editado por un ADMIN, un reseed no debe pisar el
/// contenido editado (ver logica de upsert en seed.ts).
enum PromptKey {
  SCORING
  REWRITE
  VERIFY_CLAIMS
  COMPLIANCE
  EXTRACT_CLAIMS
  CHAT_INTENT_EXTRACTION
  CHAT_REPLY_COMPOSITION
}

model PromptTemplate {
  id          String    @id @default(uuid())
  key         PromptKey @unique
  content     String    @db.Text
  updatedAt   DateTime  @updatedAt
  updatedById String?

  @@map("prompt_templates")
}

// =====================================================================
// Blog general (EcoFarma) -- distinto e independiente de Diario de la
// Salud (Article/Source arriba). Brief: MASTER_GLOBAL_BLOG_ECOFARMA.xlsx
// (444 posts planeados en 12 hubs tematicos, excluye explicitamente
// Diario de la Salud). Este primer corte solo importa una muestra
// (--limit 10 en scripts/import-blog-master.ts) y solo construye la
// pantalla de redaccion -- reviewStatus/medicalValidationStatus/
// publicationStatus quedan modelados pero sin pantalla propia todavia,
// por eso viven como String simple (valor tal cual del Excel) en vez
// de enums: no hay maquina de estados que los valide aun.
// =====================================================================

/// Unico estado con maquina de estados real en este corte -- los demas
/// estados de produccion (relectura/validacion medica/publicacion) se
/// guardan como String libre hasta que existan pantallas propias.
enum BlogDraftStatus {
  PENDIENTE_REDACCION
  EN_REDACCION
  REDACTADO
}

/// Un BlogPost = una fila de la hoja BLOG_MASTER del Excel maestro.
/// Los campos de reglas/guardarailes (regulatoryLevel, productPolicy,
/// aiGenerationRule, notes) vienen del Excel y son de solo lectura en
/// el panel -- el redactor los ve como guia, no los edita.
model BlogPost {
  id String @id @default(uuid())

  // --- Identidad / trazabilidad al Excel fuente ---
  globalId        String  @unique
  sourceContentId String?
  sourceFile      String?
  sourceRow       Int?

  // --- Taxonomia (String simple, no enum -- se lee del Excel tal cual) ---
  hub    String
  subHub String?

  // --- Contenido editorial ---
  title         String
  slug          String
  cluster       String?
  tagPrincipal  String?
  tagsSecondary String[] @default([])

  // --- Reglas / guardarailes (solo lectura en el panel, vienen del Excel) ---
  seoPriority        String?
  regulatoryLevel    String?
  intention          String?
  productPolicy      String?
  validationRequired String?
  aiGenerationRule   String? @db.Text
  notes              String? @db.Text

  // --- Estados de produccion ---
  draftStatus             BlogDraftStatus @default(PENDIENTE_REDACCION)
  reviewStatus            String          @default("À relire")
  medicalValidationStatus String          @default("À valider si requis")
  publicationStatus       String          @default("Non publié")

  sections BlogPostSection[]
  faqs     BlogFaq[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hub])
  @@index([draftStatus])
  @@map("blog_posts")
}

/// Un H2 obligatorio del articulo (brief: "Sous-titres / H2" en
/// BLOG_MASTER, separados por salto de linea). `heading` viene del
/// Excel y no es editable en el panel -- solo `body` lo escribe el
/// redactor. `order` preserva el orden exacto exigido por el brief.
model BlogPostSection {
  id      String   @id @default(uuid())
  postId  String
  post    BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  order   Int
  heading String
  body    String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([postId, order])
  @@map("blog_post_sections")
}

/// Una FAQ real (AlsoAsked) vinculada a un BlogPost -- hoja FAQ_BLOG del
/// Excel. `question` y las columnas de fuente/regla vienen del Excel;
/// `answer` es lo que redacta el usuario.
model BlogFaq {
  id     String   @id @default(uuid())
  postId String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  faqBlockId     String?
  questionNumber Int?
  question       String  @db.Text
  answer         String? @db.Text

  sourceQuestion     String? @db.Text
  sourceReferences   String? @db.Text
  regulatoryLevel    String?
  productPolicy      String?
  validationRequired String?
  notes              String? @db.Text
  sourceFile         String?
  sourceRow          Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("blog_faqs")
}

/// Catalogo de referencia -- hoja TAGS_BLOG del Excel. Se importan las
/// 242 filas completas siempre (dato barato y util), independiente de
/// cuantos BlogPost se hayan importado.
model BlogTag {
  id String @id @default(uuid())

  tag           String  @unique
  role          String?
  linkedHubs    String? @db.Text
  linkedSubHubs String? @db.Text
  contentCount  Int?
  examples      String? @db.Text
  usageRule     String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("blog_tags")
}

// =====================================================================
// Inventario (chatbot publico de disponibilidad/precio) -- alimentado
// por import masivo desde Excel (mismo patron que Blog: script Python +
// upsert de Prisma, ver scripts/import-inventory-master.ts) y editable a
// mano en el panel entre importaciones. Farmacia con multiples sucursales:
// el stock/precio SIEMPRE es por (producto, sucursal), nunca un total
// global -- ver ProductStock.
// =====================================================================

model Branch {
  id       String  @id @default(uuid())
  code     String  @unique
  name     String
  address  String?
  isActive Boolean @default(true)

  stock ProductStock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("branches")
}

/// `activeIngredient` es la base para sugerir alternativas cuando un
/// producto no tiene stock (ver InventoryService) -- mismo principio
/// activo, no el mismo nombre comercial. `requiresPrescription` existe
/// para que el chatbot NUNCA responda como si un medicamento con receta
/// estuviera "disponible para comprar" sin esa aclaracion -- ver
/// composeChatReply / reglas de compliance del chatbot.
model Product {
  id                   String  @id @default(uuid())
  sku                  String  @unique
  name                 String
  activeIngredient     String?
  category             String?
  description          String? @db.Text
  requiresPrescription Boolean @default(false)
  isActive             Boolean @default(true)

  // --- Campos que solo llena DistrimonacoSyncService (ver ese archivo) --
  // activeIngredient/category/description/requiresPrescription arriba son
  // SIEMPRE manuales (la API de Distrimonaco no los reporta) y la sync
  // nunca los toca; estos si los pisa cada sincronizacion porque vienen
  // del catalogo real del proveedor.
  labName            String?
  supplierCode       String?
  invimaRegistration String?
  externalUpdatedAt  DateTime?

  // --- Trazabilidad al Excel fuente (mismo patron que BlogPost) o a la
  // sincronizacion con Distrimonaco (sourceFile = "distrimonaco-api-sync") ---
  sourceFile String?
  sourceRow  Int?

  stock      ProductStock[]
  orderItems OrderRequestItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activeIngredient])
  @@index([category])
  @@map("products")
}

/// Precio en Decimal (nunca Float) por la misma razon de siempre con
/// dinero: evitar error de redondeo binario. Unico por (productId,
/// branchId) -- un producto puede tener stock/precio distinto en cada
/// sucursal.
model ProductStock {
  id        String @id @default(uuid())
  productId String
  branchId  String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  quantity Int     @default(0)
  price    Decimal @db.Decimal(10, 2)

  updatedAt DateTime @updatedAt

  @@unique([productId, branchId])
  @@map("product_stock")
}

// =====================================================================
// Chatbot publico de inventario -- widget embebido en el sitio WordPress
// de la farmacia, sin login (unico consumidor sin JwtAuthGuard/ApiKeyGuard
// de todo el backend, ver ChatbotController). El LLM (GeminiLlmService)
// nunca inventa stock/precio: solo redacta la respuesta a partir de lo
// que InventoryService ya consulto de forma determinista.
// =====================================================================

enum ChatMessageRole {
  USER
  ASSISTANT
}

/// `id` es el conversationId que el widget guarda en localStorage entre
/// mensajes. `ipHash` (nunca la IP cruda) es solo para rate limiting/
/// deteccion de abuso -- ver ChatbotModule.
model ChatSession {
  id      String  @id @default(uuid())
  ipHash  String?
  channel String  @default("wordpress_widget")

  messages      ChatMessage[]
  orderRequests OrderRequest[]

  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  @@index([lastMessageAt])
  @@map("chat_sessions")
}

/// `intentJson` guarda la salida de extractChatIntent (no el mensaje del
/// usuario reinterpretado) -- sirve para depurar por que el bot respondio
/// algo y para medir calidad (Fase 6 del plan), no es parte de la
/// conversacion en si.
model ChatMessage {
  id         String          @id @default(uuid())
  sessionId  String
  session    ChatSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role       ChatMessageRole
  content    String          @db.Text
  intentJson Json?

  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

enum InventorySyncStatus {
  EN_CURSO
  COMPLETADO
  FALLIDO
}

/// Historial de corridas de DistrimonacoSyncService -- mismo motivo que
/// IngestionRun: la API externa puede fallar o tardar, y el admin
/// necesita ver si la ultima sincronizacion realmente funciono antes de
/// confiar en que el chatbot esta respondiendo con stock actualizado.
model InventorySyncRun {
  id           String              @id @default(uuid())
  source       String              @default("DISTRIMONACO_API")
  status       InventorySyncStatus @default(EN_CURSO)
  itemsSynced  Int?
  errorMessage String?             @db.Text

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([startedAt])
  @@map("inventory_sync_runs")
}

// =====================================================================
// Solicitud de pedido (carrito) del chatbot -- NUNCA un checkout real ni
// pago en linea (pedido explicito del usuario): el cliente arma
// producto+cantidad en el chat, y al enviarla el personal la confirma,
// cobra y entrega por su cuenta (sucursal/WhatsApp/telefono). Toda la
// logica de cantidades/precios es determinista (ChatCartService), el LLM
// nunca participa en el carrito.
// =====================================================================

enum OrderRequestStatus {
  /// El cliente todavia esta agregando/quitando productos -- no es
  /// visible para el personal hasta que se envia (PENDIENTE).
  BORRADOR
  /// Enviada por el cliente (con nombre/telefono de contacto), esperando
  /// que el personal la revise.
  PENDIENTE
  CONFIRMADO
  CANCELADO
}

/// Un BORRADOR por ChatSession a la vez (ver ChatCartService
/// .findOrCreateDraftCart) -- si el cliente ya envio una solicitud y
/// sigue chateando, se crea un BORRADOR nuevo para la siguiente.
model OrderRequest {
  id            String             @id @default(uuid())
  sessionId     String
  session       ChatSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  status        OrderRequestStatus @default(BORRADOR)
  customerName  String?
  customerPhone String?

  items OrderRequestItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@map("order_requests")
}

/// skuSnapshot/nameSnapshot/priceSnapshot congelan el dato tal como
/// estaba al momento de agregarlo -- si Distrimonaco actualiza el precio
/// despues (sync programada), la solicitud ya enviada no debe cambiar
/// silenciosamente lo que el cliente vio.
model OrderRequestItem {
  id             String       @id @default(uuid())
  orderRequestId String
  orderRequest   OrderRequest @relation(fields: [orderRequestId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id])

  skuSnapshot   String
  nameSnapshot  String
  priceSnapshot Decimal @db.Decimal(10, 2)
  quantity      Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderRequestId, productId])
  @@map("order_request_items")
}

// =====================================================================
// Sinonimos de busqueda -- pedido explicito del usuario 2026-07-28: "que
// productos tiene para hongos" solo encontraba un producto que tenia la
// palabra "hongos" literal en el nombre (un spray), ignorando 80+
// antimicoticos reales (Fluconazol, Clotrimazol, Ketoconazol, etc) que
// no mencionan "hongos" en NombreProducto. InventoryService.searchProducts
// es coincidencia literal de texto -- esto le agrega una capa de mapeo
// categoria/sintoma -> terminos reales de producto, editable desde el
// panel (nunca hardcodeado, mismo principio que PromptTemplate).
// =====================================================================

/// `term` es lo que el cliente podria escribir (una categoria o sintoma,
/// ej. "hongos", "gripa", "dolor de cabeza"), normalizado a minusculas.
/// `relatedTerms` son fragmentos de texto real que SI aparecen en
/// Product.name/sku (ej. principios activos) -- ver
/// InventoryService.searchProducts, que hace OR de estos ademas de la
/// coincidencia literal del termino original.
model SearchSynonym {
  id           String   @id @default(uuid())
  term         String   @unique
  relatedTerms String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("search_synonyms")
}
